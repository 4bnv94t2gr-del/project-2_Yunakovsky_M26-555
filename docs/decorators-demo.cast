[0.039, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\n\r\nОперации с данными:\r\ninsert into <имя_таблицы> values (<значение1>, <значение2>, ...) - добавить запись\r\nselect from <имя_таблицы> - показать все записи\r\n"]
[0.000, "o", "select from <имя_таблицы> where <столбец> = <значение> - выбрать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\nexit - выход из программы\r\nhelp - справочная информация\r\n\r\nСтроковые значения вводите в двойных кавычках.\r\n\r\n"]
[0.001, "o", "\r\n>>>Введите команду: "]
[4.853, "o", "create_table decorators_demo name:str age:int"]
[0.950, "o", "\r\n"]
[0.002, "o", "Таблица \"decorators_demo\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.314, "o", "insert into decorators_demo values (\"Sergei\", \"wrong\")"]
[0.640, "o", "\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", "Ошибка валидации: Столбец \"age\" должен иметь тип int, получено: 'wrong'.\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.838, "o", "info decorators_demo"]
[0.245, "o", "\r\n"]
[0.001, "o", "Таблица: decorators_demo\r\nСтолбцы: ID:int, name:str, age:int\r\nКоличество записей: 0\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[5.766, "o", "insert into decorators_demo values (\"Sergei\", 28)"]
[0.306, "o", "\r\n"]
[0.000, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"decorators_demo\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.946, "o", "select from decorators_demo where age = 28"]
[1.030, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.019, "o", "+----+--------+-----+\r\n| ID |  name  | age |\r\n+----+--------+-----+\r\n| 1  | Sergei |  28 |\r\n+----+--------+-----+\r\n"]
[0.001, "o", "\r\n>>>Введите команду: "]
