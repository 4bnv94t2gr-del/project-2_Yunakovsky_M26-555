[0.042, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\n\r\nОперации с данными:\r\ninsert into <имя_таблицы> values (<значение1>, <значение2>, ...) - добавить запись\r\nselect from <имя_таблицы> - показать все записи\r\nselect from <имя_таблицы> where <столбец> = <значение> - выбрать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\n"]
[0.000, "o", "delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\ninfo <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\nexit - выход из программы\r\nhelp - справочная информация\r\n\r\nСтроковые значения вводите в двойных кавычках.\r\n\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[7.689, "o", "create_table crud_recording name:str age:int is_active:bool"]
[1.000, "o", "\r\n"]
[0.001, "o", "Таблица \"crud_recording\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[6.643, "o", "insert into crud_recording values (\"Sergei\", 28, true)"]
[0.881, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 успешно добавлена в таблицу \"crud_recording\".\r\n"]
[0.001, "o", "\r\n>>>Введите команду: "]
[6.147, "o", "insert into crud_recording values (\"Anna\", 25, false)"]
[1.099, "o", "\r\n"]
[0.002, "o", "Запись с ID=2 успешно добавлена в таблицу \"crud_recording\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.487, "o", "select from crud_recording"]
[0.858, "o", "\r\n"]
[0.021, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.593, "o", "select from crud_recording where age = 28"]
[0.494, "o", "\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.001, "o", "\r\n>>>Введите команду: "]
[4.599, "o", "update crud_recording set age = 29 where name = \"Sergei\""]
[0.504, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 в таблице \"crud_recording\" успешно обновлена.\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[5.094, "o", "select from crud_recording where name = \"Sergei\""]
[0.548, "o", "\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.424, "o", "delete from crud_recording where ID = 1"]
[0.734, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 успешно удалена из таблицы \"crud_recording\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.016, "o", "select from crud_recording"]
[0.255, "o", "\r\n"]
[0.001, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  25 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
