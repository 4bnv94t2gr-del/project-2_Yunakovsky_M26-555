{"version":3,"term":{"cols":103,"rows":63,"type":"xterm-256color","theme":{"fg":"#ffffff","bg":"#1e1e1e","palette":"#000000:#990000:#00a600:#999900:#0000b3:#b300b3:#00a6b3:#bfbfbf:#666666:#e60000:#00d900:#e6e600:#0000ff:#e600e6:#00e6e6:#e6e6e6"}},"timestamp":1793211289,"command":"make run","env":{"SHELL":"/bin/zsh"}}
[0.017, "o", "uv run database\r\n"]
[0.031, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\n\r\nОперации с данными:\r\ninsert into <имя_таблицы> values (<значение1>, <значение2>, ...) - добавить запись\r\nselect from <имя_таблицы> - показать все записи\r\nselect from <имя_таблицы> where <столбец> = <значение> - выбрать записи\r\nupdate <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n"]
[0.000, "o", "info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\nexit - выход из программы\r\nhelp - справочная информация\r\n\r\nСтроковые значения вводите в двойных кавычках.\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.161, "o", "create_table final_demo name:str age:int is_active:bool"]
[1.206, "o", "\r\n"]
[0.002, "o", "Таблица \"final_demo\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[3.771, "o", "insert into final_demo values (\"Sergei\", 28, true)"]
[0.738, "o", "\r\n"]
[0.002, "o", "Функция insert выполнилась за 0.001 секунд.\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"final_demo\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.669, "o", "insert into final_demo values (\"Anna\", 25, false)"]
[0.917, "o", "\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.001 секунд.\r\n"]
[0.001, "o", "Запись с ID=2 успешно добавлена в таблицу \"final_demo\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[3.785, "o", "select from final_demo"]
[0.438, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.260, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[4.118, "o", "select from final_demo where age = 28"]
[0.326, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
